# mslt shell aliases
# vim: set ft=bash:

# Helper: check if command exists
has() {
  command -v "$1" > /dev/null 2>&1
}

# General Aliases
has "bat" && alias cat=bat
has "brew" && alias b=brew
has "eza" && alias ls=eza
has "git" && alias g=git
has "lazygit" && alias lg=lazygit
has "helmfile" && alias hf=helmfile
has "op" && alias gh="op plugin run -- gh"
has "terraform" && alias tf=terraform
has "code" && alias c="code ."

if [[ -d $HOME/.ansible-environments ]] ; then
  alias load-ansible='source $(aem)'
  alias a="ansible"
  alias ap="ansible-playbook"
  alias av="ansible-vault"
  alias ag="ansible-galaxy"
fi

# Editor
if has "nvim" ; then
  export EDITOR=nvim
  alias vim=nvim
  alias vi=nvim
  alias v=nvim
elif has "vim" ; then
  export EDITOR=vim
  alias vi=vim
  alias v=vim
fi

# Kubernetes
if has "kubectl" ; then
  alias k=kubectl
  kconf() {
    export KUBECONFIG=$(find ~/.kube -maxdepth 1 -type f | fzf)
  }
fi

if has "tmux" ; then
  alias tmux="tmux -u"
  alias t="tmux -u"
fi

# General
alias l='ls -l'
alias ll='ls -la'

