[user]
  name = Marius Leonhardt
  email = info@marius-leonhardt.de
  signingkey = ~/.ssh/id_ed25519.pub
[alias]
  s = status
  cl = clone
  cm = commit
  ps = push
  pl = pull
  a = add
  d = diff
  co = checkout
[commit]
  gpgsign = true
[pull]
  rebase = yes
[init]
  defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[push]
  autoSetupRemote = true
[includeIf "gitdir:~/git/git.fbndrk.de/"]
  path = ~/git/git.fbndrk.de/.gitconfig
[gpg]
  format = ssh
[gpg "ssh"]
  # Generated by home-manager (msltwtf/nix) from keys.nix.
  allowedSignersFile = ~/.ssh/allowed_signers
